# Copy this file to `.env` and adjust the values for your local setup.
# Do not commit real secrets.

# Database
# Production/dev PostgreSQL:
POS_DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/banikos
# Local fallback when PostgreSQL is not available:
# POS_DATABASE_URL=sqlite:///./data/pos_data.sqlite
POS_DATA_DIR=./data

# Optional PostgreSQL command-line tools directory for backup/restore.
# Example on Windows:
# POS_PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin
POS_PG_BIN_DIR=
POS_BACKUP_RETENTION_DAYS=14
POSTGRES_DB=banikos
POSTGRES_USER=banikos
POSTGRES_PASSWORD=change_this_before_production
WEB_CONCURRENCY=2

# API security
# Comma-separated allowed browser origins. Use real domains in production.
POS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080,http://tauri.localhost,https://tauri.localhost,tauri://localhost

# Frontend API discovery
# Leave VITE_BACKEND_ORIGIN, VITE_API_BASE, and VITE_WS_BASE unset in production Docker
# when the browser should discover the backend from the current network host.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
VITE_API_BASE=http://127.0.0.1:8000/api
VITE_WS_BASE=ws://127.0.0.1:8000
VITE_PUBLIC_SITE_ORIGIN=https://your-banikos-domain.example

# Future AI Core settings
AI_PROVIDER=disabled
AI_DEFAULT_MODEL=
AI_MAX_MONTHLY_COST_BDT=0
AI_REQUIRE_HUMAN_APPROVAL=true

# Future cache/queue settings
REDIS_URL=redis://127.0.0.1:6379/0
